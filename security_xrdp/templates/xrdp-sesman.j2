# {{ ansible_managed }}
# Managed by Ansible Role: security_xrdp

# =======================================================================
# ЭТАП AUTH
# =======================================================================
auth required pam_parsec_mac.so
auth     required  pam_env.so readenv=1
auth     required  pam_env.so readenv=1 envfile=/etc/default/locale

{% if pam_xrdp_faillock_enable | default(true) | bool %}
auth    [success=1 default=ignore]      pam_succeed_if.so quiet user ingroup astra-admin
auth        required      pam_faillock.so preauth audit per_user deny={{ pam_xrdp_faillock_deny | default(8) }} unlock_time={{ pam_xrdp_faillock_unlock_time | default(900) }}
{% endif %}

{% if domain_joined | default(false) | bool %}
auth        [success=1 default=ignore]  pam_localuser.so
auth        [success=2 new_authtok_reqd=2 user_unknown=ignore default=bad]        pam_sss.so try_first_pass
{% endif %}

auth        [success=1 new_authtok_reqd=1 user_unknown=ignore default=bad]        pam_unix.so nullok try_first_pass

{% if pam_xrdp_faillock_enable | default(true) | bool %}
auth        required      pam_faillock.so authfail audit per_user deny={{ pam_xrdp_faillock_deny | default(8) }} unlock_time={{ pam_xrdp_faillock_unlock_time | default(900) }}
auth        sufficient    pam_faillock.so authsucc
{% endif %}
auth        required      pam_deny.so
-auth    optional  pam_gnome_keyring.so
-auth    optional  pam_kwallet5.so

# =======================================================================
# ЭТАП ACCOUNT
# =======================================================================
account     required      pam_parsec_mac.so create_data_if_not_exists labelselect=remoteadmin
account     required      pam_nologin.so

{% if pam_xrdp_faillock_enable | default(true) | bool %}
account     required      pam_faillock.so
{% endif %}
account     requisite     pam_listfile.so item=user sense=deny file=/etc/users.blocked onerr=succeed block_msg

account     required      pam_access.so accessfile={{ pam_xrdp_access_file | default('/etc/security/access-xrdp.conf') }}

{% if domain_joined | default(false) | bool %}
account     [success=1 default=ignore]                          pam_localuser.so
account     [success=done new_authtok_reqd=done default=bad]    pam_sss.so
{% endif %}
account     [success=done new_authtok_reqd=done default=bad]    pam_unix.so

account     requisite     pam_deny.so
account     required      pam_permit.so

# =======================================================================
# ЭТАП SESSION
# =======================================================================
session     required      pam_loginuid.so
session     optional      pam_lastlog.so quiet
session     optional      pam_keyinit.so force revoke

session     required      pam_limits.so
session     required      pam_env.so
session     required      pam_env.so user_readenv=1 envfile=/etc/default/locale

session     required      pam_kiosk2.so
session     required      pam_unix.so
{% if domain_joined | default(false) | bool %}
session     optional      pam_sss.so
{% endif %}

{% if pam_xrdp_mkhomedir_enable | default(true) | bool %}
session     optional      pam_mkhomedir.so umask={{ pam_xrdp_mkhomedir_umask | default('0077') }} skel={{ pam_xrdp_mkhomedir_skel | default('/etc/skel') }}
{% endif %}

session     required      pam_systemd.so

session     required      pam_parsec_cap.so
session     required      pam_parsec_aud.so
session     required      pam_parsec_mac.so
-session     optional      pam_gnome_keyring.so auto_start
-session     optional      pam_kwallet5.so auto_start

# =======================================================================
# ЭТАП PASSWORD (Управление и смена паролей)
# =======================================================================
{% if domain_joined | default(false) | bool %}
password    [success=1 default=2]         pam_localuser.so

password    requisite                     pam_pwquality.so
password    [success=2 default=ignore]    pam_unix.so obscure use_authtok {{ pam_xrdp_password_hash | default('yescrypt') }} try_first_pass

password    [success=1 default=ignore]    pam_sss.so use_authtok
{% else %}
password    requisite                     pam_pwquality.so
password    [success=1 default=ignore]    pam_unix.so obscure use_authtok {{ pam_xrdp_password_hash | default('yescrypt') }} try_first_pass
{% endif %}

password    requisite                     pam_deny.so
password    required                      pam_permit.so
-password   optional                      pam_gnome_keyring.so