# {{ ansible_managed }}
# Managed by Ansible Role: grub

{% macro render_cmdline(params_dict) %}
{%- for k, v in params_dict.items() -%}
  {{ k }}{{ ('=' ~ v) if v is not none and v | string != '' else '' }}{{ ' ' if not loop.last else '' }}
{%- endfor -%}
{% endmacro %}

# ------------------------------------------------------------------------------
# 1. ЛОГИКА ВЫБОРА ЯДРА И ПОВЕДЕНИЕ МЕНЮ
# ------------------------------------------------------------------------------
GRUB_DEFAULT=saved
GRUB_TIMEOUT=10
GRUB_DISTRIBUTOR=`lsb_release -i -s 2> /dev/null || echo Debian`
GRUB_SAVEDEFAULT=false
GRUB_DISABLE_SUBMENU=y
GRUB_TIMEOUT_STYLE=menu
GRUB_RECORDFAIL_TIMEOUT=10

# ------------------------------------------------------------------------------
# 2. ПАРАМЕТРЫ ЗАПУСКА ЯДРА
# ------------------------------------------------------------------------------
GRUB_CMDLINE_LINUX="{{ render_cmdline(grub_final_cmdline_linux) }}"
GRUB_CMDLINE_LINUX_DEFAULT="{{ render_cmdline(grub_final_cmdline_default) }}"
{% if ansible_facts['distribution'] == 'Astra Linux' %}
GRUB_CMDLINE_LINUX_HARDENED="{{ render_cmdline(grub_final_cmdline_hardened) }}"
{% endif %}

# ------------------------------------------------------------------------------
# 3. НАСТРОЙКА ИНТЕРФЕЙСА И ВЫВОДА GRUB
# ------------------------------------------------------------------------------
GRUB_TERMINAL=console
GRUB_GFXMODE=1024x768
GRUB_GFXPAYLOAD_LINUX=text

# ------------------------------------------------------------------------------
# 4. БЕЗОПАСНОСТЬ И ОПТИМИЗАЦИЯ СБОРКИ КОНФИГА
# ------------------------------------------------------------------------------
GRUB_DISABLE_RECOVERY="true"
GRUB_DISABLE_OS_PROBER="true"